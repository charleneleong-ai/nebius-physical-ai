# Copy to .env. Do not commit real secrets. mise loads this file automatically.

# Nebius Token Factory (Nemotron) — https://tokenfactory.nebius.com
NEBIUS_API_KEY=""
# Nebius AI Cloud project for Serverless Jobs/Endpoints (project-e00...), not the display name.
NEBIUS_PROJECT_ID=""

# Cosmos: on the A100 (`mise run cosmos-up`) use COSMOS_ENDPOINT_URL=http://127.0.0.1:8001 and no key.
# Cosmos 3 is not gated, so it needs no Hugging Face token. COSMOS_API_KEY only if the endpoint requires one.
COSMOS_ENDPOINT_URL=""
COSMOS_API_KEY=""
COSMOS_MODEL="cosmos"

# Tavily web search (Best Use of Tavily bonus).
TAVILY_API_KEY=""

HF_TOKEN=""
WANDB_API_KEY=""
WANDB_PROJECT=preflight
WANDB_ENTITY=chaleong
WANDB_MODE=online

# Headless MuJoCo rendering on the A100.
MUJOCO_GL=egl
